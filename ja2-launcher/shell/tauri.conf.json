{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JA2 Launcher",
  "version": "1.0.0",
  "identifier": "co.thewasteland.ja2launcher",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "JA2 Launcher",
        "width": 900,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost; img-src 'self' tauri://localhost data: blob:; connect-src 'self' tauri://localhost ipc://localhost; style-src 'self' tauri://localhost 'unsafe-inline'; script-src 'self' tauri://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "category": "Game",
    "shortDescription": "JA2 1.13 campaign picker + launcher",
    "longDescription": "Lets you pick from multiple JA2 1.13 campaigns and launch the right one with a click. Reads modpack.json from the same folder."
  },
  "plugins": {}
}
