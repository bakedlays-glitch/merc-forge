{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the JA2 Launcher window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "shell:default",
    "dialog:default"
  ]
}
